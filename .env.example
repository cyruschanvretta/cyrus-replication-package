# AWS Bedrock adapter
BEDROCK_MODEL_ID=
AWS_REGION=ca-central-1
# Optional. Omit these to use an instance/task role or a configured AWS profile
# instead. Values must be unquoted; a variable already set in the shell wins.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS SageMaker adapter (shares AWS_REGION above)
AWE_SAGEMAKER_ENDPOINT=

# Generic HTTP adapter (optional alternative)
AWE_MODEL_URL=
AWE_MODEL_TOKEN=
AWE_OLLAMA_URL=http://127.0.0.1:11434
AWE_OLLAMA_MODEL=gemma3:12b

# Never place student text or credentials in context_materials/.
